<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addhabit"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:gravity="center"
    tools:context=".AddHabitActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please write down the name of the habit!"
            android:textSize="20sp"
            android:fontFamily="@font/comfortaa"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_centerInParent="true"/>


        <!-- 습관 이름 입력 -->
        <EditText
            android:id="@+id/etHabitName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter habit name"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:layout_marginBottom="16dp"/>

        <!-- 알림 체크박스 -->
        <CheckBox
            android:id="@+id/cbAlarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Reminder"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- 알림 시간 선택 -->
        <TextView
            android:id="@+id/tvTimePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="09:00 AM"
            android:textSize="16sp"
            android:padding="10dp"
            android:gravity="center"
            android:background="@color/white"
            android:textColor="@color/black"
            android:visibility="gone"
            android:layout_marginBottom="24dp"/>

        <!-- 추가 버튼 -->
        <Button
            android:id="@+id/btnSaveHabit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Done"
            android:textSize="25dp"
            android:backgroundTint="@color/light_green"
            android:textColor="@color/white"
            android:textStyle="bold"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>