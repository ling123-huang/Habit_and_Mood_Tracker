<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addhabit"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    tools:context=".AddHabitActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:navigationIcon="@drawable/back"
        app:title="New Habit"
        app:titleTextColor="@color/black" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please write down the name of the habit!"
                android:textSize="20sp"
                android:fontFamily="@font/comfortaa"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/black"/>


            <!-- 습관 이름 입력 -->
            <EditText
                android:id="@+id/etHabitName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter habit name"
                android:background="@android:drawable/edit_text"
                android:padding="10dp"
                android:layout_marginBottom="16dp"/>

            <!-- 알림 설정 토글 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Set Reminder"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAlarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/GreenSwitchTheme"/>
            </LinearLayout>

            <!-- 알림 세부 설정 (숨겨져 있다가 켜지면 보임) -->
            <LinearLayout
                android:id="@+id/layoutAlarmDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- 시간 선택 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:layout_marginTop="8dp"
                    android:textColor="#666666"/>

                <TextView
                    android:id="@+id/tvTimePicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="09:00 AM"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginBottom="24dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSaveHabit"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Create Habit"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="@color/green"
        android:textColor="@color/white"
        android:layout_margin="16dp"/>
</LinearLayout>