<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHabit"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:backgroundTint="@color/white"
        android:textAllCaps="false"
        app:cornerRadius="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E0E0E0"
        app:elevation="2dp">
    </com.google.android.material.button.MaterialButton>

    <!-- 버튼 위에 커스텀 레이아웃 -->
    <LinearLayout
        android:id="@+id/habitContentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_gravity="center_vertical"
        android:clickable="false">

        <!-- 체크 아이콘 영역 -->
        <FrameLayout
            android:id="@+id/checkCircleFrame"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <!-- 바깥 원 (큰 원) -->
            <View
                android:id="@+id/viewOuterCircle"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_outer_unchecked"/>

            <!-- 안쪽 원 (작은 원) -->
            <View
                android:id="@+id/viewInnerCircle"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_inner"/>

            <!-- 월 달성율-->
            <TextView
                android:id="@+id/tvStreakDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/green"/>

        </FrameLayout>

        <!-- 습관 이름과 날짜 정보 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHabitName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="drink"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/tvHabitDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025.11.04 ~"
                android:textSize="14sp"
                android:textColor="#BDBDBD"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
